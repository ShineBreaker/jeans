;;; Guix Home 服务：会话级默认关闭遥测。
;;;
;;; 为什么需要它，而不是只靠包内 wrapper：本通道里有一批「裸 ELF、不可 wrap」
;;; 的包（codex-bin、omo-bin、herdr-bin、fresh-editor-bin、gh、zellij 等，自定位
;;; 二进制或源码构建产物），它们不经过 (jeans build telemetry) 的 wrapper 注入，
;;; 但都会在启动时读进程环境。会话级环境变量是唯一能覆盖它们的注入点，也让
;;; 非本通道安装的同类工具（上游 dotnet、go、next 项目等）一并默认关闭。
;;;
;;; 变量表就是 (jeans telemetry) 的 %telemetry-off-variables——与包内 wrapper
;;; 注入的是同一张表，不另立一份。语义同样是「默认」：这里只是把变量放进会话
;;; 环境，用户 export 自己的值就覆盖（wrapper 侧用 ${VAR:-default}，不会反过来
;;; 压掉用户在会话里设的值）。
;;;
;;; 用法：
;;;
;;;   (service home-telemetry-service-type)
;;;
;;; 想保留某个开关（例如把 traces 发到自己的 collector）：
;;;
;;;   (service home-telemetry-service-type
;;;            (home-telemetry-configuration
;;;             (variables '(("OTEL_SDK_DISABLED" . "false")))))
;;;
;;; 想彻底不要这层默认值：(home-telemetry-configuration (opt-out? #f))。

(define-module (jeans home services telemetry)
  #:use-module (gnu home services)
  #:use-module (gnu services)
  #:use-module (gnu services configuration)
  #:use-module (guix records)
  #:use-module (jeans telemetry)
  #:use-module (srfi srfi-1)
  #:export (home-telemetry-configuration
            home-telemetry-configuration?
            home-telemetry-service-type))

(define-configuration/no-serialization home-telemetry-configuration
  (opt-out?
   (boolean #t)
   "Whether to set the default telemetry opt-out variables in the Home
session environment.")
  (variables
   (alist '())
   "Extra or overriding environment variables as an alist of
@code{(NAME . VALUE)}.  Entries here win over the defaults from
@code{%telemetry-off-variables} when the names collide."))

(define (home-telemetry-environment-variables config)
  "Return the alist of environment variables contributed by CONFIG."
  (let* ((extra (home-telemetry-configuration-variables config))
         (overridden (map car extra)))
    (if (home-telemetry-configuration-opt-out? config)
        (append (remove (lambda (pair)
                          (member (car pair) overridden))
                        %telemetry-off-variables)
                extra)
        extra)))

(define home-telemetry-service-type
  (service-type
   (name 'home-telemetry)
   (description "Set cross-vendor telemetry opt-out variables
(@code{DO_NOT_TRACK}, @code{DISABLE_TELEMETRY}, @code{OTEL_SDK_DISABLED}, …)
in the Home session environment, so programs that only read their environment
stay telemetry-free by default.  Package wrappers generated by
@code{jeans-binary}/@code{jeans-electron} already carry the same defaults;
this service covers the packages that cannot be wrapped (self-locating
binaries, source builds) and anything installed outside this channel.")
   (extensions
    (list (service-extension home-environment-variables-service-type
                             home-telemetry-environment-variables)))
   (default-value (home-telemetry-configuration))))

;;; telemetry.scm ends here
